{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macula.io/schemas/fovea/assessment.schema.json",
  "title": "Fovea Assessment Header",
  "description": "The header of a fovea assessment: which attributes and which columns are in force. Validated after YAML→JSON conversion.",
  "type": "object",
  "required": ["fovea", "system", "assessment_date", "attributes", "columns"],
  "additionalProperties": false,
  "properties": {
    "fovea": {
      "type": "string",
      "const": "0.2",
      "description": "Spec version this assessment conforms to."
    },
    "system": {
      "type": "string",
      "minLength": 1,
      "description": "Slug of the assessed system; must match the directory holding this assessment."
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "description": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "required": ["core"],
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "enum": ["confidentiality", "integrity", "availability", "authenticity", "accountability"]
          },
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "description": "Must contain exactly the core five."
        },
        "enabled": {
          "type": "array",
          "items": {
            "enum": ["possession", "utility"]
          },
          "uniqueItems": true,
          "default": [],
          "description": "Parkerian extensions in force."
        },
        "disabled_justifications": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Reason for each extension NOT enabled; keys must be 'possession' or 'utility'."
        }
      }
    },
    "columns": {
      "type": "object",
      "required": ["actors", "lifecycle", "data", "environment"],
      "additionalProperties": false,
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "anyOf": [
              { "enum": ["internal", "external", "trusted_partner", "machine_agent"] },
              { "type": "string", "pattern": "^x_[a-z0-9_]+$" }
            ]
          },
          "minItems": 4
        },
        "lifecycle": {
          "type": "array",
          "items": {
            "anyOf": [
              { "enum": ["create", "acquire", "deliver", "operate", "admin", "decommission"] },
              { "type": "string", "pattern": "^x_[a-z0-9_]+$" }
            ]
          },
          "minItems": 6
        },
        "data": {
          "type": "array",
          "items": {
            "anyOf": [
              { "enum": ["at_rest", "in_motion", "in_use"] },
              { "type": "string", "pattern": "^x_[a-z0-9_]+$" }
            ]
          },
          "minItems": 3
        },
        "environment": {
          "type": "array",
          "items": {
            "anyOf": [
              { "enum": ["physical_natural", "socio_legal", "temporal"] },
              { "type": "string", "pattern": "^x_[a-z0-9_]+$" }
            ]
          },
          "minItems": 3
        }
      }
    },
    "trust_anchor_registry": { "type": "string", "description": "Relative path to the trust-anchor register." },
    "landscape": { "type": "string", "description": "Relative path to the landscape document." },
    "cells_dir": { "type": "string", "description": "Relative path to the cell directory.", "default": "cells/" },
    "owner": { "type": "string", "description": "Assessment-level owner." },
    "team": { "type": "array", "items": { "type": "string" } }
  }
}
